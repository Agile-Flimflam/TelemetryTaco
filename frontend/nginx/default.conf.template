# ${API_UPSTREAM} and ${PORT} are substituted from the environment when the container starts.
server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # The backend: the API, plus the Django admin and its static files.
    location ~ ^/(api|admin|static)/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        # The backend reads the client IP from here when TRUSTED_PROXY_COUNT is 1.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # Vite puts a content hash in every asset name, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
